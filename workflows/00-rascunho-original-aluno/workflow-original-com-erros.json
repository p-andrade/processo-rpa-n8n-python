            {
              "content": "=// 1. Captura os dados do item que está passando pelo nó\nconst nome = ;\nconst perfil = ;\nconst saldo_texto = $json.saldo_texto;\nconst recomendacao = $json.recomendacao;\nconst motivo = $json.motivo;\n\n// 2. Monta o Prompt exatamente igual ao modelo de resultado fornecido\nconst prompt = `Escreva um e-mail curto em pt-BR para o cliente abaixo, sem prometer ganhos e sem garantias.\n\nCliente:\nNome: ${nome}\nPerfil: ${perfil}\nSaldo: ${saldo_texto}\n\nRecomendação:\nProduto: ${recomendacao}\nMotivo: ${motivo}\n\nRetorne APENAS JSON com:\n{\n  \"subject\": \"...\",\n  \"text_body\": \"...\",\n  \"html_body\": \"...\"\n}`;\n\n// 3. Retorna o objeto no formato padrão que o n8n exige\nreturn [{\n  json: {\n    prompt: prompt\n  }\n}];\n"
            }
